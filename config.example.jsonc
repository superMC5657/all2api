// all2api 配置模板：cp config.example.jsonc config.jsonc 后改 apiKey / 各 provider 开关。
// JSONC：可写 // 与 /* */ 注释、可留尾逗号。
{
  "host": "127.0.0.1",
  "port": 8787,
  // 客户端 Authorization: Bearer <apiKey>。缺失 / 占位启动时自动生成并回写。
  "apiKey": "sk-all2api-change-me",
  // 不带 provider/ 前缀的模型回落到此 provider；可用 "provider/model" 显式指定。
  "defaultProvider": "qoderIntl",
  "upstreamTimeoutMs": 600000,
  // strictModels 开关：缺省 false=透传任意模型名（保旧兼容）；true=只允许各渠道 models 表内模型
  // （/v1/models 本就只列这些，转发遇到解析后不在目标渠道 models() 表里的模型直接 400 invalid_request_error）。
  // "strictModels": false,
  "providers": {
    "zcode": {
      // Start Plan JWT 通道（Anthropic/OpenAI 双协议）。不要填 bigmodel/open.bigmodel.cn 的 Key。
      "enabled": false,
      // JWT 优先级：此 jwt 非空即优先；留空自动读本机 `zcode login` 的 ~/.zcode/v2/credentials.json。
      // "jwt": "",
      // appVersion 可选，不填跟随本地安装；只有需要锁版本才填。
      // "appVersion": "3.14.3",
      // 一号一台设备指纹持久化文件（按 JWT sub 区分）。缺省 ~/.zcode/v2/all2api-device.json，支持 ~ 前缀。
      // "deviceFile": "~/.zcode/v2/all2api-device.json",
      // 仅展示（/v1/models）+ 兜底，实际可用以网关/套餐为准。
      "models": ["glm-5.3-flash", "glm-5.3-flashx"]
    },
    "qoder": {
      // bridgePath / bridgeApiKey 缺省自动处理，需覆盖才填；region: cn=国内网关，intl=海外。
      // models 仅展示 + 兜底。
      "enabled": false,
      // PAT 与本机 IDE 登录二选一：留空自动复用本机 CN 登录，有 PAT 则 PAT 优先。
      // Windows 首次建议先跑 `pnpm decrypt:qoder-cn` 验证登录是否可读。
      "pat": "",
      // sidecar 二进制显式覆盖。缺省 bridges/qoder2api（Windows 为 bridges/qoder2api.exe）。
      // "bridgePath": "bridges/qoder2api",
      // sidecar 本地鉴权密钥。缺省自动处理，需覆盖才填。
      // "bridgeApiKey": "",
      "bridgePort": 10081,
      "region": "cn",
      "models": ["Qwen3.8-Max", "DeepSeek-V4-Pro", "GLM-5.3", "Kimi-K2.7-Code", "MiniMax-M2.7"]
    },
    "qoderIntl": {
      "enabled": true,
      // 同上：留空自动复用本机 intl 登录，有 PAT 则 PAT 优先。
      "pat": "",
      "bridgePort": 10082,
      "region": "intl",
      "models": ["Qwen3.8-Max", "Qwen3.7-Max", "DeepSeek-V4-Pro", "GLM-5.3", "Kimi-K2.7-Code", "MiniMax-M2.7"]
    },
    "codebuddy": {
      "enabled": true,
      // region: cn=强制 CN（默认）；auto=按 auth.domain 动态路由（仅老配置兼容用）；intl 一般只给 codebuddyIntl 用。
      "region": "cn",
      // 留空全自动探测；特殊安装才需显式键，见 README codebuddy 一节。
      "userAgent": "all2api/0.1",
      // auth 目录显式覆盖（其下 *.info 文件；也可直接指向单个 *.info 文件）。缺省自动探测双 App 目录。
      // 双开（codebuddy + codebuddyIntl）必须给两边配不同的 authDir，否则默认探测会撞到同一份 session。
      // "authDir": "",
      // Electron 二进制显式覆盖（WORKBUDDY_ELECTRON_BIN 环境变量优先于此）。缺省自动探测。
      // "electronPath": "",
      // electronPath 的别名；两者都填时 electronPath 优先。
      // "electronBinary": "",
      // at-rest 密钥 linked-binding 名显式覆盖。缺省按序尝试各 App 绑定名，任一命中即用。
      // "keyBinding": "",
      // vscdb 凭据源（仅 .info 不可用时 fallback，Win 行为不变）。覆盖顺序：CODEBUDDY_VSCDB 环境变量 > vscdbPath。
      // "vscdbPath": "",
      // vscdb ItemTable 键名（默认 planning-genie.new.accessTokencn）。
      // "vscdbKey": "planning-genie.new.accessTokencn",
      // 钥匙环 application 名（默认 CodeBuddy CN）。
      // "vscdbApp": "CodeBuddy CN",
      // vscdb 应用目录名覆盖（默认 CodeBuddy CN，仅改变平台惯例路径中的目录段）。
      // "vscdbDir": "CodeBuddy CN",
      // 仅展示（/v1/models），拉不到时用此表。
      "models": ["glm-5.3-flash", "glm-5.3-flashx", "glm-5.3", "glm-5.2", "glm-5.1", "glm-5v-turbo", "kimi-k2.7", "kimi-k2.6", "kimi-k2.5", "deepseek-v4.1-flash", "deepseek-v4-pro", "deepseek-v4-flash", "minimax-m3-pay", "hy4-preview", "hy3", "hy3-preview", "hy3-preview-agent", "auto"]
    },
    "codebuddyIntl": {
      // 海外版（https://www.workbuddy.ai / https://www.codebuddy.ai），默认关闭（老用户升级不 breaking）。
      // 与 codebuddy 可同时启用（/v1/models 分别列出 codebuddy/... 与 codebuddy-intl/...）。
      "enabled": false,
      "region": "intl",
      "userAgent": "all2api/0.1",
      // 双开必须给两边配不同的 authDir（其下 *.info 文件；也可直接指向单个 *.info 文件），否则默认探测会撞到同一份 session。
      // "authDir": "",
      // Electron 二进制显式覆盖（WORKBUDDY_ELECTRON_BIN 环境变量优先于此；intl 优先探测 WorkBuddy AI）。缺省自动探测。
      // "electronPath": "",
      // electronPath 的别名；两者都填时 electronPath 优先。
      // "electronBinary": "",
      // at-rest 密钥 linked-binding 名显式覆盖。缺省按序尝试各 App 绑定名，任一命中即用。
      // "keyBinding": "",
      // vscdb 凭据源（仅 .info 不可用时 fallback）。未显式指定 vscdbKey 时 intl 优先试 accessToken（海外）。覆盖顺序：CODEBUDDY_VSCDB 环境变量 > vscdbPath。
      // "vscdbPath": "",
      // vscdb ItemTable 键名（intl 未显式指定时优先 planning-genie.new.accessToken）。
      // "vscdbKey": "planning-genie.new.accessToken",
      // 钥匙环 application 名（默认 CodeBuddy CN；海外登录按实际应用名覆盖）。
      // "vscdbApp": "CodeBuddy CN",
      // vscdb 应用目录名覆盖（默认 CodeBuddy CN，仅改变平台惯例路径中的目录段）。
      // "vscdbDir": "CodeBuddy CN",
      // 仅展示（/v1/models），拉不到时用此表。
      "models": ["glm-5.3-flash", "glm-5.3-flashx", "glm-5.3", "glm-5.2", "glm-5.1", "glm-5v-turbo", "kimi-k2.7", "kimi-k2.6", "kimi-k2.5", "deepseek-v4.1-flash", "deepseek-v4-pro", "deepseek-v4-flash", "minimax-m3-pay", "hy4-preview", "hy3", "hy3-preview", "hy3-preview-agent", "auto"]
    },
    "trae": {
      // Intl 海外版（https://api.trae.ai）。首版聊天为 501 骨架（AES-256-GCM agent v3 预留），models 兜底 ["auto"]。
      "enabled": false,
      // 显式 token（最高优；留空走 TRAE_API_TOKEN > ~/.trae_token > storage.json）。
      // "apiToken": "",
      // 版本显式覆盖（Trae / TRAE SOLO；环境 TRAE_EDITION 同效，config 优先）。
      // "edition": "",
      // User 目录显式覆盖（环境 TRAE_DATA_DIR 同效，config 优先；authDir 为别名，dataDir 优先）。
      // "dataDir": "",
      // IDE 版本 / UA 显式覆盖（缺省自动探测，特殊安装才填）。
      // "ideVersion": "",
      // "userAgent": "",
      // tc 盐仅走 TRAE_TC_SALT 环境变量；诊断先跑 `npm run decrypt:trae`。
      // 仅展示（/v1/models）+ 兜底，动态表待 ProjectEio 实机后接。
      "models": ["auto"]
    },
    "trae-cn": {
      // CN 国内版（AgentHost https://trae-api-cn.mchost.guru）。默认关闭，需登录 Trae CN 桌面端或填 apiToken。
      "enabled": false,
      // 显式 token（最高优；留空走 TRAE_CN_API_TOKEN > ~/.trae_cn_token > storage.json）。
      // Windows 首次建议先跑 `npm run decrypt:trae` 验证登录是否可读。
      // "apiToken": "",
      // 版本显式覆盖（TRAE SOLO CN / Trae CN；环境 TRAE_EDITION 同效，config 优先）。
      // "edition": "",
      // User 目录显式覆盖（环境 TRAE_CN_DATA_DIR 同效，config 优先；authDir 为别名，dataDir 优先）。
      // "dataDir": "",
      // IDE 版本 / UA 显式覆盖（缺省自动探测，特殊安装才填）。
      // "ideVersion": "",
      // "userAgent": "",
      // 仅展示（/v1/models）+ 白名单，动态表待实机后接。
      "models": ["auto"]
    }
  }
}
